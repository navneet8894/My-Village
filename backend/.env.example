PORT=5000
NODE_ENV=development

MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/village_management?retryWrites=true&w=majority

JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# OTP emailed when SMTP configured; otherwise OTP logged in dev
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@village.local

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Firebase Admin SDK (JSON as single line or path to service account file)
# Option A: FIREBASE_SERVICE_ACCOUNT='{"type":"service_account",...}'
# Option B: GOOGLE_APPLICATION_CREDENTIALS=./firebase-service-account.json
FIREBASE_SERVICE_ACCOUNT=

FRONTEND_URL=http://localhost:5173
MOBILE_DEEP_LINK=villageapp://

# Village default map center (optional)
VILLAGE_DEFAULT_LAT=20.5937
VILLAGE_DEFAULT_LNG=78.9629

# Google Maps (for server-side geocoding if needed)
GOOGLE_MAPS_API_KEY=
